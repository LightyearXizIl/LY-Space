{
  "name": "ly-space-desktop",
  "version": "0.0.2",
  "description": "LY Space desktop creative workspace",
  "author": "LY Space",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "icon": "node scripts/generate-icon.cjs",
    "check": "pnpm --dir renderer run typecheck && pnpm --dir ../canvas-agent run test",
    "prepare:agent": "node scripts/prepare-agent-runtime.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "pack:win": "pnpm run check && pnpm --dir renderer run build && pnpm --dir ../canvas-agent run build && pnpm run icon && pnpm run prepare:agent && electron-builder --win nsis --x64 --publish never && pnpm run verify:package"
  },
  "build": {
    "appId": "com.lyspace.desktop",
    "productName": "LY Space",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "asar": false,
    "executableName": "LY Space",
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png",
      "renderer/dist/**/*"
    ],
    "extraResources": [
      {
        "from": ".runtime/canvas-agent",
        "to": "canvas-agent",
        "filter": [
          "dist/**/*",
          "agent-instructions.md",
          "package.json"
        ]
      },
      {
        "from": ".runtime/canvas-agent/production-dependencies",
        "to": "canvas-agent/node_modules"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "electronLanguages": ["zh-CN", "en-US"],
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LY Space"
    },
    "artifactName": "LY Space Setup ${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3"
  }
}
