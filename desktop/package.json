{
  "name": "ly-space-desktop",
  "version": "0.2.4",
  "description": "LY Space desktop creative workspace",
  "author": "LY Space",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "icon": "node scripts/generate-icon.cjs",
    "check": "pnpm --dir renderer run typecheck",
    "verify:package": "node scripts/verify-package.cjs",
    "pack:win": "pnpm run check && pnpm --dir renderer run build && pnpm run icon && electron-builder --win nsis --x64 --publish never && pnpm run verify:package",
    "publish:win": "pnpm run check && pnpm --dir renderer run build && pnpm run icon && electron-builder --win nsis --x64 --publish always && pnpm run verify:package",
    "verify:release": "node scripts/verify-release-version.cjs"
  },
  "build": {
    "appId": "com.lyspace.desktop",
    "productName": "LY Space",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "asar": false,
    "executableName": "LY Space",
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png",
      "renderer/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LY Space",
      "include": "build/nsis-custom.nsh"
    },
    "artifactName": "LY Space Setup ${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "LightyearXizIl",
        "repo": "LY-Space",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
